# ── Database (Postgres via Prisma) ──────────────────────────────────────
# Neon (names match what Vercel Storage → Neon and `neon env pull` set):
# DATABASE_URL = pooled (app traffic), DATABASE_URL_UNPOOLED = direct (used
# only by `prisma migrate`). Without a pooler, set both to the same value.
DATABASE_URL=postgresql://user:password@host:5432/bioground
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/bioground

# ── Staff sign-in (Auth.js) ─────────────────────────────────────────────
# Signs session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
# Canonical origin, e.g. https://bioground.com. Used in staff email links
# and allowed automatically for booking requests. Optional on Vercel: the
# production domain (VERCEL_PROJECT_PRODUCTION_URL) is used when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bookings (see docs/BOOKINGS.md) ─────────────────────────────────────
# Extra origins allowed to POST /api/bookings from a browser, comma-separated.
BOOKING_ALLOWED_ORIGINS=
# Staff inbox for new-booking alerts (no health details in the email).
BOOKING_NOTIFY_EMAIL=
# Bookings accepted per store per hourly slot.
BOOKING_SLOT_CAPACITY=2

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────
# Required in production: the booking API refuses to run without it rather
# than fall back to a per-instance in-memory limiter. Vercel Storage →
# Upstash for Redis sets KV_REST_API_URL / KV_REST_API_TOKEN instead; either
# pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
