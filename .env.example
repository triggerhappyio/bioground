# ── Database (Postgres via Prisma) ──────────────────────────────────────
# Neon or Supabase. With a pooler, DATABASE_URL = pooled, DIRECT_URL = direct
# (used only by `prisma migrate`). Without one, set both to the same value.
DATABASE_URL=postgresql://user:password@host:5432/bioground
DIRECT_URL=postgresql://user:password@host:5432/bioground

# ── Staff sign-in (Auth.js) ─────────────────────────────────────────────
# Signs session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
# Canonical origin, e.g. https://bioground.com. Used in staff email links
# and allowed automatically for booking requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bookings (see docs/BOOKINGS.md) ─────────────────────────────────────
# Extra origins allowed to POST /api/bookings from a browser, comma-separated.
BOOKING_ALLOWED_ORIGINS=
# Staff inbox for new-booking alerts (no health details in the email).
BOOKING_NOTIFY_EMAIL=
# Bookings accepted per store per hourly slot.
BOOKING_SLOT_CAPACITY=2

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────
# Required in production: the booking API refuses to run without it rather
# than fall back to a per-instance in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
